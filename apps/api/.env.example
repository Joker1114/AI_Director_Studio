# Docker Compose database password; choose a strong unique value
POSTGRES_PASSWORD=replace_with_long_random_password
DATABASE_URL=postgresql+psycopg://director:replace_me@postgres:5432/director
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL_COMPLEX=qwen3.8-max
QWEN_MODEL_FAST=qwen3.8-flash
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=2
APP_API_TOKEN=replace_with_at_least_32_random_characters
APP_ALLOW_LOCAL_NO_TOKEN=false
MEDIA_DIR=./data/media
GENERATION_DIR=./data/generated
COMFYUI_NODES_FILE=config/gpu_nodes.json
COMFYUI_WORKFLOW_ROOT=../../workflows/comfyui
GENERATION_POLL_SECONDS=3
GENERATION_TIMEOUT_SECONDS=3600
GENERATION_WORKER_IDLE_SECONDS=2
MAX_UPLOAD_MB=12
CORS_ORIGINS=
